{%- assign product_url = product.url -%}
{%- assign product_image = product.featured_image -%}
{%- assign product_price = product.price -%}
{%- assign product_compare_price = product.compare_at_price -%}
{%- assign on_sale = false -%}
{%- if product_compare_price > product_price -%}
  {%- assign on_sale = true -%}
  {%- assign discount_amount = product_compare_price | minus: product_price -%}
  {%- assign discount_pct = discount_amount | times: 100 | divided_by: product_compare_price -%}
{%- endif -%}

<div class="product-card" data-product-id="{{ product.id }}">
  <a href="{{ product_url }}" class="product-card__link" tabindex="-1" aria-hidden="true">
    <div class="product-card__image-wrapper">
      {%- if on_sale -%}
        <span class="product-card__badge product-card__badge--sale">-{{ discount_pct }}%</span>
      {%- endif -%}
      {%- if product.available == false -%}
        <span class="product-card__badge product-card__badge--soldout">Esaurito</span>
      {%- endif -%}
      {%- if product_image != blank -%}
        <img
          src="{{ product_image | image_url: width: 600 }}"
          alt="{{ product_image.alt | default: product.title | escape }}"
          class="product-card__img"
          loading="lazy"
          width="600"
          height="600"
        >
      {%- else -%}
        <div class="product-card__img-placeholder">🎮</div>
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__body">
    {%- if product.vendor -%}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    <h3 class="product-card__title">
      <a href="{{ product_url }}" class="product-card__title-link">{{ product.title }}</a>
    </h3>

    <div class="product-card__price-row">
      {% render 'price', product: product %}
    </div>

    {%- if product.available -%}
      <form action="/cart/add" method="post" class="product-card__form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn btn--primary btn--full btn--sm product-card__atc" data-product-id="{{ product.id }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          Aggiungi al Carrello
        </button>
      </form>
    {%- else -%}
      <button class="btn btn--outline btn--full btn--sm" disabled>Esaurito</button>
    {%- endif -%}
  </div>
</div>
