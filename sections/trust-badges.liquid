<section class="trust-badges section-padding--sm">
  <div class="container">
    <div class="trust-badges__grid">
      {%- for block in section.blocks -%}
        <div class="trust-badge" {{ block.shopify_attributes }}>
          <span class="trust-badge__icon">{{ block.settings.icon }}</span>
          <div class="trust-badge__text">
            <strong class="trust-badge__title">{{ block.settings.title }}</strong>
            <span class="trust-badge__subtitle">{{ block.settings.subtitle }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Badge di Fiducia",
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {"type": "text", "id": "icon", "label": "Emoji icona", "default": "🔒"},
        {"type": "text", "id": "title", "label": "Titolo", "default": "Pagamento Sicuro"},
        {"type": "text", "id": "subtitle", "label": "Sottotitolo", "default": "Stripe SSL certificato"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Badge di Fiducia",
      "blocks": [
        {"type": "badge", "settings": {"icon": "🔒", "title": "Pagamento Sicuro", "subtitle": "Stripe SSL certificato"}},
        {"type": "badge", "settings": {"icon": "🚚", "title": "Spedizione Tracciata", "subtitle": "Tracking in tempo reale"}},
        {"type": "badge", "settings": {"icon": "↩️", "title": "Reso 14 Giorni", "subtitle": "Diritto di recesso UE"}},
        {"type": "badge", "settings": {"icon": "💬", "title": "Supporto WhatsApp", "subtitle": "Disponibile 7 giorni su 7"}}
      ]
    }
  ]
}
{% endschema %}
