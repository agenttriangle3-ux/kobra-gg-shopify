<section class="image-with-text section-padding {% if section.settings.image_position == 'right' %}image-with-text--reversed{% endif %}">
  <div class="container">
    <div class="image-with-text__inner">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading }}" loading="lazy" width="800" height="600" class="image-with-text__img">
        {%- else -%}
          <div class="image-with-text__placeholder">
            <span>{{ section.settings.placeholder_icon | default: '🎮' }}</span>
          </div>
        {%- endif -%}
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="image-with-text__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.btn_text != blank -%}
          <a href="{{ section.settings.btn_url }}" class="btn btn--primary">{{ section.settings.btn_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Immagine con Testo",
  "settings": [
    {"type": "select", "id": "image_position", "label": "Posizione immagine", "options": [{"value": "left", "label": "Sinistra"}, {"value": "right", "label": "Destra"}], "default": "left"},
    {"type": "image_picker", "id": "image", "label": "Immagine"},
    {"type": "text", "id": "placeholder_icon", "label": "Icona placeholder", "default": "🎮"},
    {"type": "text", "id": "eyebrow", "label": "Testo sopra titolo"},
    {"type": "text", "id": "heading", "label": "Titolo", "default": "Brand 100% Italiano"},
    {"type": "richtext", "id": "text", "label": "Testo"},
    {"type": "text", "id": "btn_text", "label": "Testo bottone"},
    {"type": "url", "id": "btn_url", "label": "Link bottone"}
  ],
  "presets": [
    {
      "name": "Immagine con Testo",
      "settings": {
        "heading": "Brand 100% Italiano",
        "eyebrow": "Chi Siamo"
      }
    }
  ]
}
{% endschema %}
