{% layout 'theme' %}

<section class="error-page section-padding">
  <div class="container">
    <div class="error-page__inner">
      <h1 class="error-page__code">404</h1>
      <h2 class="error-page__title">Pagina Non Trovata</h2>
      <p class="error-page__text">La pagina che stai cercando non esiste o è stata spostata.</p>
      <div class="error-page__actions">
        <a href="/" class="btn btn--primary btn--lg">Torna alla Homepage</a>
        <a href="/collections/all" class="btn btn--outline btn--lg">Esplora i Prodotti</a>
      </div>
    </div>
  </div>
</section>
